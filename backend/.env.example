OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DATABASE_URL=postgresql://user:password@localhost:5432/groundly
ALLOWED_ORIGIN=http://localhost:5173
# Optional -- enables the live web-retrieval fallback when local grounding
# is empty. Free tier at tavily.com. Omit to leave that fallback disabled.
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Gemini is the default text-generation provider (agents/llm_provider.py);
# OpenAI is always the fallback, so OPENAI_API_KEY above is still required.
# Set LLM_PROVIDER=openai to disable the Gemini path entirely. A missing
# GEMINI_API_KEY degrades every call to OpenAI instead of failing -- it's
# optional in that sense, but every call runs on OpenAI alone without it.
LLM_PROVIDER=gemini
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-3.8-flash
# Optional -- defaults to GEMINI_MODEL above if omitted. Only set this if
# you want the claim verifier/repair pass on a different Gemini model.
GEMINI_VERIFIER_MODEL=gemini-3.8-flash